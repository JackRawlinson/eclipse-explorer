# Cloudflare Pages reads this; nginx and the dev server ignore it. It replaces
# the caching and MIME rules that docker/nginx.conf applies in the container.
#
# Pages MERGES the headers from every rule that matches, rather than letting the
# most specific one win. So a Cache-Control on /* does not get overridden lower
# down -- it is concatenated with it, and `no-cache` in that list means the
# browser revalidates whatever else the list says. That is why /* sets no
# Cache-Control at all here, and each group states its own.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The site itself: revalidate every time, so a deploy is picked up at once.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/circumstances.js
  Cache-Control: no-cache

/lunar.js
  Cache-Control: no-cache

/sim.js
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

/vendor/*
  Cache-Control: no-cache

# Landing pages and the sitemap: revalidate, they change when the pipeline runs.
/eclipse/*
  Cache-Control: no-cache

/sitemap.xml
  Cache-Control: no-cache

# Share images, fetched by social scrapers via each page's og:image.
/preview/*
  Cache-Control: public, max-age=2592000

# Per-eclipse geometry and shading masks. Every request for these carries a ?v=
# build stamp taken from index.json, so a new build is a new URL and these can
# be cached hard without ever going stale.
/data/*
  Cache-Control: public, max-age=2592000

# The index is where that build stamp comes from, so it must not be. This does
# merge with the rule above, leaving both max-age and no-cache -- and no-cache
# is the one that decides: the browser revalidates before using it.
/data/index.json
  Cache-Control: no-cache

# Browsers refuse an ES module served as anything but a JavaScript type, and
# refuse it harder with nosniff set above. Named one by one rather than by
# wildcard: vendor/ also holds a stylesheet and a licence, and a pattern wide
# enough to catch the modules would have handed those the wrong type too.
/vendor/maplibre-gl.mjs
  Content-Type: text/javascript; charset=utf-8

/vendor/maplibre-gl-shared.mjs
  Content-Type: text/javascript; charset=utf-8

/vendor/maplibre-gl-worker.mjs
  Content-Type: text/javascript; charset=utf-8
